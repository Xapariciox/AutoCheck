# Copia este archivo a .env y ajusta los valores. El .env NO se sube a Git.

# Perfil de Spring activo: dev | test | prod
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL (contenedor "db")
DB_NAME=autocheck
DB_USER=autocheck
DB_PASSWORD=autocheck
# Puerto expuesto en tu máquina. Si ya tienes otro PostgreSQL en 5432, usa 5433
DB_PORT=5432

# URL que usa el backend cuando lo arrancas desde IntelliJ (fuera de Docker).
# Dentro de Docker, docker-compose la sobrescribe con el host "db".
DB_URL=jdbc:postgresql://localhost:5432/autocheck

# Puerto del backend en tu máquina
BACKEND_PORT=8080
